// # ooglyph Main Entry Point
//
// Logline: Interactive glyph search and viewer for Nerd Font symbols and Unicode iconography.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, --demo, or --mcp.
//   2. Query curated glyph database by keyword, taxonomy category, or exact codepoint.
//   3. Format results as aligned terminal tables, single-character streams, or structured JSON.
//   4. Execute comprehensive multi-tier internal self-checks when invoked with --test.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";
import "anchor.oo";

fn run_all_tests() -> Bool {
    // Cross-subsystem verification
    if !verify_root_subsystem() {
        return false;
    }

    // Tier 1: Options parsing test
    let t1_args: List[String] = list_push(list_push(list_new(), "-c"), "developer");
    let opts: CliOptions = parse_cli_options(t1_args);
    if opts.category_filter != "developer" {
        return false;
    }

    // Tier 2: Search test
    let search_res: GlyphSearchResult = search_glyphs("rust");
    if search_res.match_count == 0 {
        return false;
    }

    // Tier 3: Lookup test
    let lookup_res: GlyphSearchResult = lookup_glyph_exact("git");
    if lookup_res.match_count == 0 {
        return false;
    }

    // Tier 4: Single char rendering
    let char_out: String = render_single_char_only(lookup_res.items);
    if chars_len(char_out) == 0 {
        return false;
    }

    return true;
}

pub fn main(
    fr: &FsReadCap,
    _pr: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Int {
    let opts: CliOptions = parse_cli_options(args);

    if opts.show_help {
        print(render_cli_help());
        return 0;
    }
    if opts.show_version {
        print(render_cli_version());
        return 0;
    }
    if opts.run_test {
        if run_all_tests() {
            print("ooglyph: internal anchor tests PASSED\n");
            return 0;
        } else {
            print("ooglyph: internal anchor tests FAILED\n");
            return 1;
        }
    }
    if opts.show_mcp {
        return run_mcp_server(fr);
    }
    if opts.show_demo {
        print(render_glyph_demo(opts.use_color));
        return 0;
    }
    if opts.show_categories {
        let summaries: List[CategorySummary] = get_category_summaries();
        if opts.json_output {
            print(category_summaries_to_json(summaries) + "\n");
        } else {
            print(render_categories_table(summaries, opts.use_color));
        }
        return 0;
    }

    // Query resolution
    let mut search_res: GlyphSearchResult = make_search_result("", list_new());

    if chars_len(opts.codepoint_filter) > 0 {
        search_res = lookup_glyph_exact(opts.codepoint_filter);
    } else if chars_len(opts.category_filter) > 0 {
        let items: List[GlyphItem] = filter_by_category(opts.category_filter);
        search_res = make_search_result(opts.category_filter, items);
    } else if chars_len(opts.query) > 0 {
        search_res = search_glyphs(opts.query);
    } else {
        // Default display: full standard catalog
        let all_items: List[GlyphItem] = get_standard_catalog();
        search_res = make_search_result("all", all_items);
    }

    if opts.char_only {
        print(render_single_char_only(search_res.items));
        return 0;
    }

    if opts.json_output {
        print(search_result_to_json(search_res) + "\n");
        return 0;
    }

    print(render_glyph_list(search_res.items, opts.use_color));
    return 0;
}
